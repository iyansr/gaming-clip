{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "settings": {
    "react": { "version": "19" }
  },
  "rules": {
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-var": "error",
    "prefer-const": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }],
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": ["error", { "checksVoidReturn": { "attributes": false } }],
    "typescript/await-thenable": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "promise/no-return-wrap": "error",
    "react/jsx-key": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/prefer-array-flat-map": "error",

    // Off on purpose: sequential awaits are intentional (chunked whisper, serial jobs), React effects return
    // cleanups conditionally, canvas contexts are structurally cast between the browser and @napi-rs/canvas,
    // and Array(n).fill is idiomatic for fixed-size buffers.
    "no-await-in-loop": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "unicorn/no-new-array": "off",
    "unicorn/prefer-add-event-listener": "off",
    "jsx-a11y/prefer-tag-over-role": "warn",
    // Labels here wrap the control plus a caption nested a few spans deep (title + description, value readout);
    // the default depth of 2 misses that text, so the rule reports labels that are in fact named.
    "jsx-a11y/label-has-associated-control": ["error", { "depth": 5 }]
  },
  "overrides": [
    {
      "files": ["tests/**", "**/*.test.ts"],
      "rules": {
        "typescript/no-non-null-assertion": "off"
      }
    }
  ],
  "ignorePatterns": ["tools/**", "workspace/**", "models/**", "node_modules/**"]
}
