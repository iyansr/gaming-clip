# Everything below is optional. Most people never need this file: the web UI's Settings dialog
# (gear icon) covers the highlight AI, the whisper model, the default language and parallel renders.
# A value set here (or in the environment) WINS over the Settings dialog and shows there as locked.

# --- Server ---------------------------------------------------------------------------------------
# PORT=4321
# Bind address. Default 127.0.0.1 (this machine only). 0.0.0.0 exposes the UI, your media and
# local-file project input to the whole network: only on a network you trust.
# HOST=127.0.0.1

# --- Settings-dialog fields (set here only to lock them) -----------------------------------------
# whisper.cpp model name -> <models>/ggml-<name>.bin
# WHISPER_MODEL=large-v3-turbo-q5_0
# Clips rendered at once (default 2; 1 = one after another)
# GCLIP_RENDER_JOBS=2

# Highlight AI through an API (via Anvia, https://anvia.dev). LLM_MODEL unset = built-in heuristics.
# LLM_PROVIDER=openai       -> OpenAI-compatible Chat Completions (OpenAI, OpenRouter, Groq, Ollama, LM Studio)
# LLM_PROVIDER=anthropic    -> Claude-compatible Messages API (Anthropic or a compatible gateway)
# LLM_BASE_URL is optional: unset = the provider's own API.
#   openai:    include /v1      e.g. http://localhost:11434/v1
#   anthropic: without /v1      e.g. https://gateway.example.com
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Highlight AI through any command-line AI you are signed in to (advanced; env only, never settable
# from the UI). The prompt is piped to stdin; stdout must be the JSON answer. Wins over LLM_MODEL.
# The Settings dialog offers fixed presets for the Claude Code and Codex CLIs instead.
# LLM_COMMAND=claude -p --tools ""

# --- Paths and binaries ---------------------------------------------------------------------------
# GCLIP_WORKSPACE=workspace
# GCLIP_MODELS=models
# Tools: an explicit value here wins, then tools/<name> (what `bun run setup` downloads), then PATH.
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# YT_DLP_BIN=yt-dlp
# WHISPER_BIN=whisper-cli
# Force the H.264 encoder: libx264, h264_videotoolbox (macOS), libopenh264 or h264_mf (Windows).
# Unset = libx264 when your ffmpeg has it, else the first platform encoder it has.
# GCLIP_VIDEO_ENCODER=
# Download whisper models from another URL (https:// mirror or file:// path) instead of Hugging Face.
# GCLIP_WHISPER_MODEL_URL=
