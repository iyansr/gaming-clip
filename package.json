{
  "name": "gaming-clip",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "dev": "NODE_ENV=development bun --hot src/server/index.ts",
    "start": "bun src/server/index.ts",
    "clip": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.9.0",
    "@anvia/anthropic": "^1.2.2",
    "@anvia/core": "^1.19.2",
    "@anvia/openai": "^1.3.8",
    "@napi-rs/canvas": "^1.1.1",
    "lucide-react": "^1.73.0",
    "onnxruntime-node": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
