{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./src/web/styles.css"
  },
  "sortPackageJson": true,
  "ignorePatterns": ["tools/**", "workspace/**", "models/**", "bun.lock", "LICENSE", "assets/**"]
}
