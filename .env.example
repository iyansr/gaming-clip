# Server port (default 4321)
# PORT=4321

# whisper.cpp model name -> models/ggml-<name>.bin (run `bun run setup` after changing)
# WHISPER_MODEL=large-v3-turbo-q5_0

# Optional: a model picks the highlights (through Anvia, https://anvia.dev).
# Leave LLM_MODEL unset to use the built-in audio + transcript heuristics.
# LLM_PROVIDER=openai       -> OpenAI-compatible Chat Completions (OpenAI, OpenRouter, Groq, Ollama, LM Studio)
# LLM_PROVIDER=anthropic    -> Claude-compatible Messages API (Anthropic or a compatible gateway)
# LLM_BASE_URL is optional: unset = the provider's own API.
#   openai:    include /v1      e.g. http://localhost:11434/v1
#   anthropic: without /v1      e.g. https://gateway.example.com
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Optional overrides
# GCLIP_WORKSPACE=workspace
# GCLIP_MODELS=models
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# YT_DLP_BIN=yt-dlp
# WHISPER_BIN=whisper-cli

# Bind address. Default 127.0.0.1 (this machine only). 0.0.0.0 exposes the UI, your media and
# local-file project input to the whole network: only on a network you trust.
# HOST=127.0.0.1

# Highlight picking with a coding-agent CLI you are already signed in to (no API key).
# The prompt is piped to the command's stdin; its stdout must be the JSON answer.
# Takes precedence over LLM_BASE_URL. Each run starts 1 CLI session per ~10 minutes of video.
# LLM_COMMAND=claude -p --tools ""
